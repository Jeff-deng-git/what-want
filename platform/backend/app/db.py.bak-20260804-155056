"""


def get_db_path() -> Path:
    p = Path(DB_PATH)
    p.parent.mkdir(parents=True, exist_ok=True)
    return p


@contextmanager
def get_conn():
    conn = sqlite3.connect(str(get_db_path()))
    conn.row_factory = sqlite3.Row
    try:
        yield conn
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


def _migrate_chapter_configs_pk():
    """One-shot migration: chapter_configs originally had PK(chapter_id) which
    blocked the version+1 upsert in seed_ch4.py. Rebuild as PK(chapter_id, version)
    preserving existing rows. Idempotent: skip if PK already composite.
    Also drops any leftover legacy staging tables from failed prior runs."""
    with get_conn() as c:
        # Drop any leftover staging tables from failed prior runs (both names seen)
        c.execute("DROP TABLE IF EXISTS chapter_configs__old")
        c.execute("DROP TABLE IF EXISTS chapter_configs__legacy")
        cols = [r[1] for r in c.execute("PRAGMA table_info(chapter_configs)").fetchall()]
        if not cols:
            return
        pk_rows = c.execute("PRAGMA table_info(chapter_configs)").fetchall()
        # In SQLite PRAGMA table_info, the `pk` column is 0 for non-PK columns,
        # and 1-based position for PK columns. Composite PK -> max(pk) > 1.
        max_pk = max((r[5] for r in pk_rows), default=0)
        if max_pk > 1:
            return  # composite PK already in place
        # Old single-column PK -- rebuild
        c.execute("ALTER TABLE chapter_configs RENAME TO chapter_configs__legacy")
        c.execute("""
            CREATE TABLE chapter_configs (
              chapter_id TEXT NOT NULL,
              version INTEGER NOT NULL,
              config_json TEXT NOT NULL,
              active INTEGER DEFAULT 1,
              created_at TIMESTAMP DEFAULT (datetime('now')),
              PRIMARY KEY (chapter_id, version)
            )
        """)
        c.execute("""
            INSERT INTO chapter_configs (chapter_id, version, config_json, active, created_at)
            SELECT chapter_id, COALESCE(version, 1), config_json, active, created_at
            FROM chapter_configs__legacy
        """)
        c.execute("DROP TABLE chapter_configs__legacy")


def init_db():
    with get_conn() as conn:
        conn.executescript(SCHEMA)
    _migrate_chapter_configs_pk()
    # Defensive ALTERs for upgrades from pre-error schema.
    # The SCHEMA already includes `error`, but old databases (pre-Task 1) lack it.
    # IF NOT EXISTS for ADD COLUMN isn't in SQLite; swallow the duplicate-column error.
    for ddl in ("ALTER TABLE step_runs ADD COLUMN error TEXT",):
        try:
            with get_conn() as c:
                c.execute(ddl)
        except Exception:
            pass
    logger.info(f"DB initialized at {get_db_path()}")

