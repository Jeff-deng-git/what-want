"""What Want DB -- 简化版 sqlite init + connection."""
import logging
import sqlite3
import os
from contextlib import contextmanager
from pathlib import Path

from app.config import DB_PATH

logger = logging.getLogger(__name__)

# Schema (M1 + M2 + M3 from plan S数据模型)
SCHEMA = """
