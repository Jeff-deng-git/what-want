{
  "callout_labels": ["POINT"],
  "identifier_rules": [
    {"id": "ocr.identifier.jgj", "prefix": "JGJ", "suffix_pattern": "[0-9]{3}"},
    {"id": "ocr.identifier.dgj", "prefix": "DGJ", "suffix_pattern": "[0-9]{2}-[0-9]{3}-[0-9]{4}"},
    {"id": "ocr.identifier.gb", "prefix": "GB/T", "suffix_pattern": "[0-9]+(?:\\.[0-9]+)?"}
  ],
  "parentheses": "preserve",
  "cjk_gap": "conservative",
  "alignment_threshold": 0.95,
  "disabled_rules": [],
  "manual_replacements": [
    {
      "page": 12,
      "before": "exact context-anchored string before replacement",
      "after": "corrected text",
      "mode": "exact"
    }
  ],
  "_verbose": false
}