  function shuffleUnlocked(arr){
    var lockedIdx = [], pool = [];
    arr.forEach(function(x, i){ if (x.locked) lockedIdx.push(i); else pool.push(x); });
    for (var k = pool.length-1; k > 0; k--){ var j = Math.floor(Math.random()*(k+1)); var t = pool[k]; pool[k] = pool[j]; pool[j] = t; }
    var out = [], p = 0;
    for (var i = 0; i < arr.length; i++){ out.push(lockedIdx.indexOf(i) >= 0 ? arr[i] : pool[p++]); }
    return out;
  }

