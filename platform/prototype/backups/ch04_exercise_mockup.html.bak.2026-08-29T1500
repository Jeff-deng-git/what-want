<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>What_Want · 第四章练习 — 重要的事（价值观）</title>
<style>
  :root{
    --paper:#f6efde;
    --paper-light:#faf4e3;
    --paper-edge:#ebe1c8;
    --ink:#2a2620;
    --ink-soft:#6b6354;
    --ink-faint:#9c937f;
    --accent:#7a4d2b;       /* 赭石：ch04 主色（书卷气） */
    --accent-soft:#d8c4a3;
    --accent-bg:#f1e8d2;
    --green:#4d6b3f;
    --rule:#d9cfb6;
    --c-self:#7a4d2b;       /* 自我 / 可控 */
    --c-other:#6b7f9f;      /* 他人 / 不可控 */
    --shadow-sm:0 1px 3px rgba(42,38,32,.10);
    --shadow-md:0 4px 14px rgba(42,38,32,.14);
    --serif:"Source Han Serif SC","Noto Serif SC","Songti SC","SimSun",serif;
    --sans:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:var(--serif);color:var(--ink);background-color:var(--paper);
    background-image:radial-gradient(circle at 18% 12%, rgba(255,255,255,.55), transparent 42%),
                     radial-gradient(circle at 82% 78%, rgba(216,196,163,.28), transparent 46%);
    background-attachment:fixed;min-height:100vh;line-height:1.72;-webkit-font-smoothing:antialiased;
  }

  /* ---------- Top bar ---------- */
  .top-bar{position:sticky;top:0;z-index:30;display:flex;align-items:center;gap:18px;padding:12px 24px;
    background:var(--paper-light);border-bottom:1px solid var(--paper-edge);box-shadow:var(--shadow-sm);font-family:var(--sans);}
  .top-bar .chap-info{display:flex;flex-direction:column;line-height:1.3;min-width:170px;}
  .top-bar .chap-info .k{font-size:11px;color:var(--ink-faint);letter-spacing:.04em;}
  .top-bar .chap-info .v{font-size:14px;color:var(--accent);font-weight:600;}
  .progress-wrap{flex:1;display:flex;align-items:center;gap:10px;}
  .progress-track{flex:1;height:6px;border-radius:99px;background:var(--paper-edge);overflow:hidden;}
  .progress-fill{height:100%;width:20%;background:var(--accent);border-radius:99px;transition:width .35s ease;}
  .progress-label{font-size:12px;color:var(--ink-soft);white-space:nowrap;}
  .nav-btns{display:flex;gap:8px;}
  .nav-btn{font-family:var(--sans);font-size:13px;color:var(--ink-soft);background:var(--paper);
    border:1px solid var(--paper-edge);border-radius:3px;padding:6px 12px;cursor:pointer;transition:.18s;}
  .nav-btn:hover{border-color:var(--accent-soft);color:var(--accent);}
  .nav-btn:disabled{opacity:.4;cursor:not-allowed;}

  /* ---------- Reader 3-col（沿用 ch02/03 三列壳） ---------- */
  .reader.three-col{display:grid;grid-template-columns:190px 1fr 340px;gap:20px;max-width:1180px;margin:0 auto;padding:22px 24px 60px;}

  /* ---------- Left: step-nav ---------- */
  .step-nav{font-family:var(--sans);}
  .step-nav .nav-title{font-size:12px;color:var(--ink-faint);letter-spacing:.06em;text-transform:uppercase;margin:0 0 12px 4px;}
  .step-nav .item{display:flex;align-items:flex-start;gap:10px;padding:9px 10px;border-radius:4px;cursor:pointer;
    margin-bottom:4px;transition:.18s;color:var(--ink-soft);}
  .step-nav .item:hover{background:var(--paper-light);}
  .step-nav .item .dot{flex:none;width:20px;height:20px;border-radius:50%;border:1.5px solid var(--accent-soft);
    color:var(--accent);font-size:12px;font-weight:600;display:flex;align-items:center;justify-content:center;
    background:var(--paper-light);margin-top:1px;transition:.18s;}
  .step-nav .item .txt{display:flex;flex-direction:column;line-height:1.3;}
  .step-nav .item .txt .t1{font-size:13px;color:var(--ink);font-weight:500;}
  .step-nav .item .txt .t2{font-size:11px;color:var(--ink-faint);}
  .step-nav .item.active{background:var(--accent-bg);}
  .step-nav .item.active .dot{background:var(--accent);border-color:var(--accent);color:#fff;}
  .step-nav .item.submitted .dot{background:var(--accent-soft);border-color:var(--accent-soft);color:var(--accent);}
  .step-nav .item.submitted .dot::after{content:"✓";}
  .step-nav .item.submitted .dot span{display:none;}
  .step-nav .item.locked .dot{border-color:var(--green);background:rgba(77,107,63,.12);color:var(--green);}

  /* ---------- Center: chapter-content ---------- */
  .chapter-content{font-family:var(--serif);}
  .chapter-content .book-title{font-size:12px;color:var(--accent);letter-spacing:.05em;margin:0 0 3px;}
  .chapter-content h1{font-size:20px;line-height:1.4;margin:0 0 5px;color:var(--ink);font-weight:600;}
  .chapter-content .chap-sub{font-size:12.5px;color:var(--ink-soft);margin:0 0 16px;font-family:var(--sans);}
  .chapter-content h2{font-size:16px;margin:22px 0 8px;color:var(--ink);}
  .chapter-content p{margin:0 0 14px;color:var(--ink);}
  .chapter-content .quote{border-left:3px solid var(--accent-soft);background:var(--paper-light);padding:12px 16px;
    margin:18px 0;border-radius:0 4px 4px 0;color:var(--ink-soft);font-size:15px;font-style:normal;}
  .chapter-content .quote b{color:var(--accent);}
  .chapter-content .lead-chip{display:inline-block;font-family:var(--sans);font-size:13px;background:var(--accent-bg);
    color:var(--accent);border:1px solid var(--accent-soft);border-radius:99px;padding:5px 14px;margin:4px 0 18px;}
  .def-list{font-family:var(--sans);font-size:13px;line-height:1.7;margin:10px 0 16px;padding-left:0;list-style:none;}
  .def-list li{padding:6px 0;border-bottom:1px dotted var(--paper-edge);}
  .def-list li b{color:var(--accent);}
  #stepFocus{background:var(--paper-light);border:1px solid var(--paper-edge);border-left:3px solid var(--accent);
    border-radius:0 4px 4px 0;padding:11px 14px;margin:8px 0 16px;font-family:var(--sans);font-size:13px;line-height:1.65;color:var(--ink-soft);}
  #stepFocus .sf-title{display:block;font-family:var(--sans);font-size:12.5px;color:var(--accent);font-weight:600;margin-bottom:4px;}
  #stepFocus .sf-echo{display:block;font-size:11.5px;color:var(--ink-faint);margin-top:6px;}
  .ref-line{font-family:var(--sans);font-size:10.5px;color:var(--ink-faint);margin:8px 2px 10px;line-height:1.45;}

  /* ---------- Right: side-panel ---------- */
  .side-panel{background:var(--paper-light);border:1px solid var(--paper-edge);border-radius:4px;
    box-shadow:var(--shadow-sm);overflow:hidden;align-self:start;position:sticky;top:78px;}
  .side-tabs{display:flex;border-bottom:1px solid var(--paper-edge);font-family:var(--sans);}
  .side-tabs .st{flex:1;text-align:center;font-size:13px;color:var(--ink-soft);padding:11px 0;cursor:pointer;position:relative;transition:.18s;}
  .side-tabs .st:hover{color:var(--accent);}
  .side-tabs .st.active{color:var(--accent);font-weight:600;}
  .side-tabs .st.active::after{content:"";position:absolute;left:18%;right:18%;bottom:-1px;height:2px;background:var(--accent);}
  .side-pane{display:none;padding:16px;max-height:74vh;overflow-y:auto;}
  .side-pane.active{display:block;}

  /* ---------- Step card ---------- */
  .stage-card{border:1px solid var(--paper-edge);border-radius:4px;background:var(--paper);margin-bottom:12px;overflow:hidden;}
  .hint-card{font-family:var(--sans);font-size:12px;color:var(--ink-soft);background:var(--accent-bg);
    border:1px dashed var(--accent-soft);border-radius:4px;padding:9px 11px;margin:12px 0;}
  .hint-card .hc-lbl{display:block;font-family:var(--sans);font-size:10.5px;color:var(--accent);letter-spacing:.04em;margin-bottom:5px;}
  .hint-card b{color:var(--accent);}
  .btn{font-family:var(--sans);font-size:13px;border-radius:3px;cursor:pointer;padding:8px 14px;transition:.18s;
    border:1px solid var(--accent);background:var(--accent);color:#fff;}
  .btn:hover{filter:brightness(1.06);}
  .btn.ghost{background:var(--paper-light);color:var(--accent);border:1px solid var(--accent-soft);}
  .btn.ghost:hover{background:var(--accent-bg);}
  .btn:disabled{opacity:.45;cursor:not-allowed;}
  .btn-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:4px;}
  .toast{font-family:var(--sans);font-size:12.5px;color:#fff;background:var(--accent);border-radius:3px;
    padding:8px 13px;margin-top:10px;display:none;box-shadow:var(--shadow-md);}
  .toast.show{display:block;}
  .pane-empty{font-family:var(--sans);font-size:13px;color:var(--ink-faint);text-align:center;padding:30px 10px;line-height:1.7;}
  .chat-bubble{font-family:var(--sans);font-size:13px;margin-bottom:10px;}
  .chat-bubble.mentor{background:var(--accent-bg);border:1px solid var(--accent-soft);border-radius:8px 8px 8px 2px;padding:9px 12px;color:var(--ink);}
  .chat-bubble.me{background:var(--paper);border:1px solid var(--paper-edge);border-radius:8px 8px 2px 8px;padding:9px 12px;color:var(--ink-soft);text-align:right;}
  .note-line{font-family:var(--sans);font-size:12.5px;color:var(--ink-soft);border-bottom:1px dotted var(--paper-edge);padding:8px 2px;}

  /* step-card elements */
  .step-card{background:#fffdf7;border:1px solid var(--paper-edge);border-radius:4px;box-shadow:var(--shadow-sm);
    margin:14px 12px 12px;overflow:hidden;font-family:var(--serif);}
  .step-head{display:flex;flex-direction:column;gap:6px;padding:10px 13px 9px;border-bottom:1px solid var(--rule);background:var(--paper-light);}
  .step-head-row{display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0;}
  .step-head-left{display:flex;align-items:center;gap:7px;min-width:0;flex:1;}
  .step-num{font-family:var(--sans);font-size:11px;color:#fff;background:var(--ink);border-radius:50%;width:18px;height:18px;
    display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;}
  .step-title-text{font-family:var(--sans);font-size:14px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .step-sub{font-family:var(--sans);font-size:11px;color:var(--ink-faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .step-head-right{display:flex;align-items:center;gap:6px;flex-shrink:0;}
  .role-chip{font-family:var(--sans);font-size:11px;color:var(--ink-soft);background:var(--paper);border:1px solid var(--paper-edge);
    border-radius:99px;padding:3px 9px;display:inline-flex;align-items:center;gap:3px;white-space:nowrap;}
  .role-lock{font-size:10px;}
  .step-guide-btn{width:22px;height:22px;border-radius:50%;border:1px solid var(--accent-soft);background:var(--paper);
    color:var(--accent);font-weight:700;font-size:13px;cursor:pointer;line-height:1;padding:0;font-family:var(--sans);}
  .step-guide-btn:hover{background:var(--accent-bg);}
  .step-guide-btn[aria-expanded="true"]{background:var(--accent);color:var(--paper);border-color:var(--accent);}
  .step-guide-popover{background:var(--accent-bg);border:1px dashed var(--accent-soft);border-radius:4px;padding:11px 14px;
    margin:8px 13px 0;font-family:var(--sans);font-size:12px;color:var(--ink-soft);line-height:1.7;}
  .step-guide-popover strong{color:var(--accent);display:block;margin-bottom:4px;font-size:12.5px;}
  .step-guide-popover ol{margin:6px 0 0;padding-left:22px;}
  .step-guide-popover li{margin-bottom:3px;}
  .step-guide-popover li b{color:var(--ink);}
  .step-strip{display:flex;align-items:center;gap:0;padding:11px 13px 12px;border-bottom:1px dotted var(--paper-edge);background:#fffdf7;}
  .strip-item{flex:1;display:flex;align-items:center;gap:6px;font-family:var(--sans);font-size:11.5px;color:var(--ink-faint);
    background:transparent;border:none;cursor:pointer;padding:4px 2px;border-radius:3px;transition:.14s;text-align:left;}
  .strip-item:hover{color:var(--ink);}
  .strip-item .dot{width:18px;height:18px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;
    font-size:10px;font-weight:600;border:1.5px solid var(--paper-edge);background:var(--paper);color:var(--ink-faint);flex-shrink:0;transition:.14s;}
  .strip-item.active{color:var(--accent);font-weight:600;}
  .strip-item.active .dot{background:var(--accent);border-color:var(--accent);color:#fff;}
  .strip-item.done{color:var(--ink-soft);}
  .strip-item.done .dot{background:var(--accent-soft);border-color:var(--accent-soft);color:var(--accent);}
  .strip-item:disabled{cursor:default;}
  .strip-line{height:1px;background:var(--paper-edge);flex:0 0 6px;margin:0 -2px;}
  .step-body{padding:6px 13px 13px;}
  .lead-chip{font-family:var(--sans);font-size:12.5px;color:var(--ink-soft);background:var(--accent-bg);
    border-left:2px solid var(--accent-soft);padding:6px 10px;border-radius:0 3px 3px 0;margin:10px 0 8px;line-height:1.5;}

  /* ----- ch04 各类组件 ----- */
  .q-block{background:var(--paper-light);border:1px solid var(--paper-edge);border-radius:4px;padding:9px 11px;margin-bottom:9px;}
  .q-block.demo{background:rgba(122,77,43,.05);border:1px dashed var(--accent-soft);}
  .q-label{font-family:var(--sans);font-size:12.5px;color:var(--ink);font-weight:500;margin-bottom:6px;line-height:1.5;display:block;}
  .q-input{width:100%;font-family:var(--serif);font-size:13px;color:var(--ink);background:#fffdf7;
    border:1px solid var(--paper-edge);border-radius:4px;padding:7px 9px;outline:none;resize:vertical;min-height:54px;line-height:1.55;}
  .q-input:focus{border-color:var(--accent-soft);}
  .q-input::placeholder{color:var(--ink-faint);font-size:12.5px;}

  .scratch{background:var(--accent-bg);border:1px dashed var(--accent-soft);border-radius:4px;padding:8px 11px;margin-bottom:10px;font-family:var(--sans);}
  .scratch .sc-lbl{font-size:11px;color:var(--accent);font-weight:600;display:block;margin-bottom:5px;}
  .scratch .sc-items{display:flex;flex-wrap:wrap;gap:5px;}
  .scratch .sc-empty{font-size:11px;color:var(--ink-faint);}
  .scratch .sc-chip{font-size:11px;background:var(--paper-light);border:1px solid var(--accent-soft);color:var(--ink);
    border-radius:99px;padding:2px 9px;display:inline-flex;align-items:center;gap:4px;}
  .scratch .sc-chip b{color:var(--accent);cursor:pointer;}
  .drawer-open{font-family:var(--sans);font-size:12px;color:var(--accent);background:var(--paper);border:1px solid var(--accent-soft);
    border-radius:3px;padding:6px 11px;cursor:pointer;transition:.16s;}
  .drawer-open:hover{background:var(--accent-bg);}

  .guide-q{font-family:var(--sans);margin:8px 2px 10px;border:1px dashed var(--accent-soft);border-radius:4px;background:var(--accent-bg);padding:8px 11px;}
  .guide-q summary{cursor:pointer;font-size:12px;color:var(--accent);font-weight:600;outline:none;}
  .guide-q ol{margin:8px 0 0;padding-left:22px;font-size:12px;color:var(--ink-soft);line-height:1.7;}
  .guide-q li{margin-bottom:4px;word-break:break-word;}

  /* top_values chips */
  .chip-list{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0;}
  .chip{font-family:var(--sans);font-size:12px;background:var(--paper-light);border:1px solid var(--accent-soft);
    border-radius:99px;padding:4px 10px;display:inline-flex;align-items:center;gap:5px;color:var(--ink);}
  .chip .c-edit{font-family:var(--serif);font-size:12px;border:none;background:transparent;outline:none;color:var(--ink);min-width:40px;width:auto;}
  .chip .c-del{color:var(--ink-faint);cursor:pointer;font-size:13px;}
  .chip .c-del:hover{color:#a23b2b;}
  .chip .c-lock{font-size:10px;color:var(--green);cursor:pointer;}

  /* AI commentary */
  .ai-comment{font-family:var(--serif);font-size:13.5px;color:var(--ink);background:var(--paper-light);
    border:1px solid var(--accent-soft);border-radius:4px;padding:11px 13px;margin:12px 0;line-height:1.7;}
  .ai-comment .who{font-family:var(--sans);font-size:11px;color:var(--accent);display:block;margin-bottom:6px;letter-spacing:.04em;}
  .ai-comment ul{margin:6px 0;padding-left:20px;}
  .ai-comment li{margin-bottom:4px;}
  .ai-comment b{color:var(--accent);}

  /* groups cards (step-2) */
  .group-card{border:1px solid var(--paper-edge);border-radius:4px;padding:9px 11px;margin-bottom:8px;background:#fffdf7;transition:.18s;}
  .group-card.locked{border-color:var(--accent);background:var(--accent-bg);}
  .group-head{display:flex;align-items:center;gap:8px;}
  .group-umb{font-family:var(--sans);font-size:13px;font-weight:600;color:var(--ink);border:none;background:transparent;outline:none;flex:1;min-width:0;
    border-bottom:1px dotted var(--paper-edge);padding:2px 0;}
  .group-umb:focus{border-bottom-color:var(--accent);}
  .group-lock-btn{font-family:var(--sans);font-size:11px;color:var(--accent);background:var(--paper);border:1px solid var(--accent-soft);
    border-radius:99px;padding:2px 9px;cursor:pointer;}
  .group-lock-btn.on{background:var(--accent);color:#fff;border-color:var(--accent);}
  .group-kw{font-family:var(--serif);font-size:12.5px;color:var(--ink-soft);margin-top:6px;line-height:1.55;}
  .group-kw .kw{display:inline-block;background:var(--paper-light);border:1px solid var(--paper-edge);border-radius:3px;padding:1px 7px;margin:2px 3px 2px 0;}
  .group-add{font-family:var(--sans);font-size:11.5px;color:var(--accent);background:transparent;border:1px dashed var(--accent-soft);
    border-radius:3px;padding:4px 8px;cursor:pointer;margin-top:6px;}

  /* conversions (step-3) */
  .conv-item{border:1px solid var(--paper-edge);border-radius:4px;padding:9px 11px;margin-bottom:8px;background:#fffdf7;}
  .conv-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .conv-val{font-family:var(--serif);font-size:13px;font-weight:600;color:var(--ink);}
  .conv-badge{font-family:var(--sans);font-size:10.5px;padding:2px 8px;border-radius:99px;font-weight:600;}
  .conv-badge.other{background:#eef2f6;color:var(--c-other);border:1px solid #c3cedd;}
  .conv-badge.self{background:var(--accent-bg);color:var(--accent);border:1px solid var(--accent-soft);}
  .conv-toggle{font-family:var(--sans);font-size:11px;color:var(--accent);background:var(--paper);border:1px solid var(--accent-soft);
    border-radius:99px;padding:2px 9px;cursor:pointer;margin-left:auto;}
  .conv-converted{font-family:var(--serif);font-size:12.5px;color:var(--green);margin-top:6px;}
  .conv-converted .cc-lbl{font-family:var(--sans);font-size:10.5px;color:var(--ink-faint);margin-right:4px;}
  .why-chain{margin-top:7px;border-left:2px solid var(--accent-soft);padding-left:11px;font-family:var(--sans);font-size:11.5px;color:var(--ink-soft);line-height:1.6;}
  .why-node{position:relative;padding:2px 0 2px 14px;}
  .why-node::before{content:"›";position:absolute;left:0;color:var(--accent);font-weight:700;}
  .why-node:last-child{color:var(--green);font-weight:600;}

  /* pyramid (step-4) */
  .pyramid{margin:8px 0;}
  .pyr-item{display:flex;align-items:center;gap:8px;background:#fffdf7;border:1px solid var(--paper-edge);border-radius:4px;padding:8px 10px;margin-bottom:6px;transition:.18s;}
  .pyr-item.locked{border-color:var(--accent);background:var(--accent-bg);}
  .pyr-tier{font-family:var(--sans);font-size:10px;color:var(--ink-faint);flex:none;width:54px;}
  .pyr-txt{font-family:var(--serif);font-size:13px;color:var(--ink);flex:1;min-width:0;}
  .pyr-btns{display:flex;gap:3px;flex:none;}
  .pyr-up,.pyr-down{font-family:var(--sans);font-size:12px;width:22px;height:22px;border-radius:3px;border:1px solid var(--accent-soft);
    background:var(--paper);color:var(--accent);cursor:pointer;line-height:1;}
  .pyr-up:disabled,.pyr-down:disabled{opacity:.35;cursor:not-allowed;}
  .pyr-lock{font-size:11px;cursor:pointer;color:var(--ink-faint);}
  .pyr-lock.on{color:var(--green);}
  .pyr-note{font-family:var(--sans);font-size:10.5px;color:var(--ink-faint);text-align:center;margin-top:6px;}

  /* work purpose (step-5) */
  .wp-card{background:linear-gradient(180deg,var(--accent-bg),var(--paper-light));border:1px solid var(--accent);border-radius:6px;
    padding:15px 14px;font-family:var(--serif);text-align:center;box-shadow:var(--shadow-sm);margin:10px 0;}
  .wp-card .wp-lbl{font-family:var(--sans);font-size:11px;color:var(--accent);letter-spacing:.05em;display:block;margin-bottom:6px;}
  .wp-card .wp-text{font-size:16px;color:var(--accent);font-weight:600;line-height:1.5;}
