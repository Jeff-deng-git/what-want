      setTimeout(function(){ markSubmitted(3); renderStep(4); }, 900);
    });
  }

  /* ===== step-4：金字塔排序 ===== */
  function renderStep4(){
    if (!data.step2 || !data.step3) return flashToast("请先完成 step-2 / step-3。");
    if (!data.step4) data.step4 = { ranked: DEMO_RANKED.map(function(r){ return { value:r.value, locked:r.locked }; }) };
    renderStep4Body();
  }
  function renderStep4Body(){
    var n = data.step4.ranked.length;
    var items = "";
    for (var i = n-1; i >= 0; i--){
      var r = data.step4.ranked[i];
      var tier = (i===0) ? "底层 · 基础" : (i===n-1 ? "顶层 · 最终目的" : "第 "+(i+1)+" 层");
      items +=
        '<div class="pyr-item'+(r.locked?' locked':'')+'" data-pi="'+i+'">'+
        '  <span class="pyr-tier">'+tier+'</span>'+
        '  <span class="pyr-txt">'+esc(r.value)+'</span>'+
        '  <span class="pyr-lock'+(r.locked?' on':'')+'" data-lock="'+i+'" title="锁定">'+(r.locked?'🔒':'🔓')+'</span>'+
        '  <span class="pyr-btns">'+
        '    <button class="pyr-up" data-up="'+i+'" '+(i===0?'disabled':'')+' type="button">↑ 更基础</button>'+
        '    <button class="pyr-down" data-down="'+i+'" '+(i===n-1?'disabled':'')+' type="button">↓ 更靠目的</button>'+
        '  </span>'+
      '</div>';
    }
    var html =
      '<div class="stage-pane">'+
      '  <div class="lead-chip">输入：step-2 分组 + step-3 转化已注入</div>'+
      '  <div class="hint-card"><span class="hc-lbl">排序规则</span>底层=优先满足的<b>基础价值观</b>，顶层=你的<b>人生最终目的</b>。拖拽（原型用 ↑/↓ 按钮）排序；🔒 锁定项重排时保留位置。</div>'+
      '  <div class="pyramid">'+items+'</div>'+
      '  <div class="pyr-note">视觉顶部 = 最终目的，底部 = 基础价值观；自底向上读，越往上越接近你想成为的人</div>'+
      '  <div class="btn-row">'+
      '    <button class="btn ghost" id="reRank" type="button">重新生成</button>'+
      '    <button class="btn" id="confirm4" type="button">确认并保存（解锁 step-5）</button>'+
      '  </div>'+
      '  <div class="saved-state" id="savedState4">✓ 已保存 — 金字塔排序已记入，并沉淀为跨章种子（ch8 会引用）。</div>'+
      '</div>';
    body.innerHTML = html;
    data.step4.ranked.forEach(function(r, i){
      var item = body.querySelector('.pyr-item[data-pi="'+i+'"]');
      item.querySelector('[data-lock="'+i+'"]').addEventListener("click", function(){
        r.locked = !r.locked;
        item.classList.toggle("locked", r.locked);
        this.classList.toggle("on", r.locked);
        this.textContent = r.locked ? "🔒" : "🔓";
        flashToast(r.locked ? "已锁定该层（重排保留）" : "已解锁该层");
      });
      var up = item.querySelector('[data-up="'+i+'"]');
      var down = item.querySelector('[data-down="'+i+'"]');
      if (up) up.addEventListener("click", function(){ moveRank(i, -1); });
      if (down) down.addEventListener("click", function(){ moveRank(i, 1); });
    });
    document.getElementById("reRank").addEventListener("click", function(){ var locked=data.step4.ranked.filter(function(r){return r.locked;}).length; data.step4.ranked = shuffleUnlocked(data.step4.ranked); flashToast(locked>0?("已按 "+locked+" 层锁定保留，其余重排。"):"已重新排序金字塔。"); renderStep4Body(); });
    document.getElementById("confirm4").addEventListener("click", function(){
      if (this.dataset.done) return;
      this.dataset.done = "1";
      document.getElementById("savedState4").classList.add("show");
      setTimeout(function(){ markSubmitted(4); renderStep(5); }, 900);
    });
  }
  function moveRank(i, dir){
    var j = i + dir;
    if (j < 0 || j >= data.step4.ranked.length) return;
    if (data.step4.ranked[i].locked || data.step4.ranked[j].locked) return flashToast("锁定项不能移动，先解锁。");
    var tmp = data.step4.ranked[i];
    data.step4.ranked[i] = data.step4.ranked[j];
    data.step4.ranked[j] = tmp;
    renderStep4Body();
  }

  /* ===== step-5：工作目的 ===== */
  function renderStep5(){
    if (!data.step4) return flashToast("请先完成 step-4 金字塔。");
    var html =
      '<div class="stage-pane">'+
      '  <div class="lead-chip">输入：step-4 金字塔（'+data.step4.ranked.length+' 项）已注入</div>'+
      '  <div class="hint-card"><span class="hc-lbl">做法</span>列出 <b>10 段</b>向他人提供价值的经历（每条一行）。AI 标注每条体现的价值观、统计最高频者定为工作目的；排除「让别人开心」这类过泛表述。你可在卡片上手写覆盖。</div>'+
      '  <textarea class="exp-area" id="expArea" placeholder="例如：\n朋友转行前找我聊了三次，最后定了方向\n帮同事梳理项目优先级，他说「一下子通了」\n…（写 10 段）">'+DEMO_EXPERIENCES.join("\n")+'</textarea>'+
      '  <div class="btn-row"><button class="btn" id="genWpBtn" type="button">让职业顾问定工作目的 →</button></div>'+
      '  <div class="toast" id="toast"></div>'+
      '</div>';
    body.innerHTML = html;
    document.getElementById("genWpBtn").addEventListener("click", function(){
      var lines = document.getElementById("expArea").value.split("\n").map(function(s){return s.trim();}).filter(Boolean);
      if (lines.length < 10) return flashToast("请先列出至少 10 段经历（已写 "+lines.length+" 段）。");
      flashToast("职业顾问正在标注价值观、统计高频…");
      setTimeout(function(){
        data.step5 = { work_purpose: DEMO_WORK_PURPOSE, reasoning: DEMO_REASONING,
          experience_map: lines.map(function(l, idx){ return { experience:l, values: DEMO_EXP_VALUES[idx]||[] }; }) };
        renderStep5Result();
      }, 700);
    });
  }
  function renderStep5Result(){
    var rows = data.step5.experience_map.map(function(m){
      var tags = (m.values||[]).map(function(v){ return '<span class="vtag">'+esc(v)+'</span>'; }).join("");
      return '<div class="exp-row"><span class="exp">'+esc(m.experience)+'</span><span class="vals">'+tags+'</span></div>';
    }).join("");
    var html =
      '<div class="stage-pane">'+
      '  <div class="wp-card"><span class="wp-lbl">你的一句话工作目的（可直接修改，AI 的建议只是起点）</span>'+
      '    <textarea class="wp-override" id="wpOverride" placeholder="不认可 AI 建议？在这里写你心里的版本">'+esc(data.step5.work_purpose)+'</textarea>'+
      '  </div>'+
      '  <div class="ai-comment"><span class="who">职业顾问 · 推理（只读）</span><span>'+mdLite(data.step5.reasoning)+'</span></div>'+
      '  <div class="lead-chip">经历 → 价值观映射（只读）</div>'+
      '  <div class="exp-map">'+rows+'</div>'+
      '  <div class="btn-row">'+
      '    <button class="btn ghost" id="reWp" type="button">换一种说法</button>'+
      '    <button class="btn" id="confirm5" type="button">确认并保存（本章完成）</button>'+
      '  </div>'+
      '  <div class="saved-state" id="savedState5">✓ 已保存 — 工作目的 / 金字塔 / 价值观已沉淀为跨章种子：这句话会在第七章帮你筛方向、在第八章陪你落地实践。</div>'+
      '</div>';
    body.innerHTML = html;
    document.getElementById("reWp").addEventListener("click", function(){
      var alt = "陪更多人把『想做的事』想清楚，用自己的方式活。";
      data.step5.work_purpose = alt;
      document.getElementById("wpOverride").value = alt;
      flashToast("已换一种说法。");
    });
    document.getElementById("confirm5").addEventListener("click", function(){
      if (this.dataset.done) return;
      data.step5.work_purpose = document.getElementById("wpOverride").value.trim() || data.step5.work_purpose;
      this.dataset.done = "1";
      document.getElementById("savedState5").classList.add("show");
      setTimeout(function(){ markSubmitted(5); renderChapterComplete(); }, 900);
    });
  }
  function renderChapterComplete(){
    topFill.style.width = "100%";
    topLabel.textContent = "步骤 5 / 5 · 本章完成";
    var html =
      '<div class="step-complete">'+
      '  <div class="title">第四章 · 重要的事（价值观）已完成</div>'+
      '  <div>你的价值观关键词、思维导图、金字塔排序、一句话工作目的已沉淀为跨章种子。第 7 章（组合）会拿「工作目的」作过滤器，第 8 章（实践）会回响「金字塔 / 价值观」增强你的成功宣言。<br>想先和导师聊聊这版结论？点下方继续。</div>'+
      '  <div class="btn-row">'+
      '    <button class="btn ghost" id="reviewBtn" type="button">回看任一步</button>'+
      '    <button class="btn" id="chatBtn" type="button">和导师聊聊 →</button>'+
      '  </div>'+
      '</div>';
    body.innerHTML = html;
    document.getElementById("reviewBtn").addEventListener("click", function(){ renderStep(1); });
    document.getElementById("chatBtn").addEventListener("click", function(){ switchTab("chat"); });
  }

  /* ===== step-1 已提交态（回看） ===== */
  function renderSubmitted(n){
    if (n===1 && data.step1){
      var chips = data.step1.top_values.map(function(v){ return '<span class="chip" style="cursor:default;">'+esc(v)+'</span>'; }).join("");
      body.innerHTML = '<div class="step-complete"><div class="title">step-1 已锁定（整步提交态）</div>'+
        '<div>价值观关键词 '+data.step1.top_values.length+' 个已记入。要在本章内重做，请点「重新做本章」。</div>'+
        '<div class="chip-list" style="margin-top:8px;">'+chips+'</div>'+
        '<div class="btn-row"><button class="btn ghost" id="redoStep" type="button">重新做本章（建新草稿）</button></div></div>';
      document.getElementById("redoStep").addEventListener("click", redoChapter);
      return;
    }
    if (n===2 && data.step2){
      var cards = data.step2.groups.map(function(g){ return '<div class="group-card'+(g.locked?' locked':'')+'"><div class="group-head"><span class="group-umb" style="border:none;">'+esc(g.umbrella)+'</span></div><div class="group-kw">'+g.keywords.map(function(k){return '<span class="kw">'+esc(k)+'</span>';}).join("")+'</div></div>'; }).join("");
      body.innerHTML = '<div class="step-complete"><div class="title">step-2 已锁定</div><div>思维导图 '+data.step2.groups.length+' 组已记入。</div><div id="g2" style="margin-top:8px;">'+cards+'</div><div class="btn-row"><button class="btn ghost" id="redoStep" type="button">重新做本章</button></div></div>';
      document.getElementById("redoStep").addEventListener("click", redoChapter);
      return;
    }
    if (n===3 && data.step3){
      var items = data.step3.conversions.map(function(c){ return '<div class="conv-item"><div class="conv-head"><span class="conv-val">'+esc(c.value)+'</span>'+(c.type==="other"?'<span class="conv-badge other">他人</span>':'<span class="conv-badge self">自我</span>')+'</div>'+(c.type==="other"?'<div class="conv-converted"><span class="cc-lbl">转化为</span>'+esc(c.converted_to)+'</div>':'')+'</div>'; }).join("");
      body.innerHTML = '<div class="step-complete"><div class="title">step-3 已锁定</div><div>可控性转化 '+data.step3.conversions.length+' 项已记入。</div><div style="margin-top:8px;">'+items+'</div><div class="btn-row"><button class="btn ghost" id="redoStep" type="button">重新做本章</button></div></div>';
      document.getElementById("redoStep").addEventListener("click", redoChapter);
      return;
    }
    if (n===4 && data.step4){
      var p = data.step4.ranked.map(function(r,i){ var tier=(i===0)?"底层·基础":(i===data.step4.ranked.length-1?"顶层·最终目的":"第"+(i+1)+"层"); return '<div class="pyr-item'+(r.locked?' locked':'')+'"><span class="pyr-tier">'+tier+'</span><span class="pyr-txt">'+esc(r.value)+'</span></div>'; }).join("");
      body.innerHTML = '<div class="step-complete"><div class="title">step-4 已锁定</div><div>金字塔 '+data.step4.ranked.length+' 层已记入（并已沉淀为跨章种子）。</div><div class="pyramid" style="margin-top:8px;">'+p+'</div><div class="btn-row"><button class="btn ghost" id="redoStep" type="button">重新做本章</button></div></div>';
      document.getElementById("redoStep").addEventListener("click", redoChapter);
      return;
    }
    if (n===5 && data.step5){
      body.innerHTML = '<div class="step-complete"><div class="title">step-5 已锁定</div><div>工作目的：「'+esc(data.step5.work_purpose)+'」已沉淀。</div><div class="btn-row"><button class="btn ghost" id="redoStep" type="button">重新做本章</button><button class="btn" id="chatBtn5" type="button">和导师聊聊 →</button></div></div>';
      document.getElementById("redoStep").addEventListener("click", redoChapter);
      document.getElementById("chatBtn5").addEventListener("click", function(){ switchTab("chat"); });
      return;
    }
    renderBody(n);
  }

  function redoChapter(){
    if (!confirm("重新做本章会建一份新草稿，原档案保留。\n确定开始？")) return;
    data = { step1:null, step2:null, step3:null, step4:null, step5:null };
    submitted = { 1:false, 2:false, 3:false, 4:false, 5:false };
    lastReached = 1;
    renderStep(1);
  }

  /* ----------------- step-1 引用关键词到候选词 ----------------- */
  function bindChipList(){
    body.querySelectorAll(".chip .c-del").forEach(function(d){
      d.addEventListener("click", function(){ d.parentNode.remove(); collectVals(); });
    });
    body.querySelectorAll(".chip .c-lock").forEach(function(l){
      l.addEventListener("click", function(){ flashToast("（原型）锁定仅作展示；正式靠整步提交态生效。"); });
    });
    body.querySelectorAll(".chip .c-edit").forEach(function(e){
      e.addEventListener("input", collectVals);
    });
  }
  function collectVals(){
    if (!data.step1) data.step1 = { top_values:[], commentary:"" };
    data.step1.top_values = Array.prototype.map.call(body.querySelectorAll("#valChips .chip .c-edit"), function(inp){ return inp.value.trim(); }).filter(Boolean);
  }

  /* ----------------- 100 例抽屉 ----------------- */
  var drawer = document.getElementById("drawer");
  var drawerMask = document.getElementById("drawerMask");
  var drawerGrid = document.getElementById("drawerGrid");
  var drawerSearch = document.getElementById("drawerSearch");
  function buildDrawer(){
    drawerGrid.innerHTML = VALUE_100.map(function(v){ return '<span class="example-chip" data-v="'+esc(v)+'">'+esc(v)+'</span>'; }).join("");
    drawerGrid.querySelectorAll(".example-chip").forEach(function(c){
      c.addEventListener("click", function(){
        addScratch(c.getAttribute("data-v"));
        closeDrawer();
      });
    });
  }
  function addScratch(v){
    var box = document.getElementById("scratchItems") || document.getElementById("scratchItems2");
    if (!box) { flashToast("请先停留在 step-1 / step-2 才能引用候选词。"); return; }
    if (box.querySelector(".sc-empty")) box.innerHTML = "";
    var chip = document.createElement("span");
    chip.className = "sc-chip";
    chip.innerHTML = esc(v) + ' <b title="移除">✕</b>';
    chip.querySelector("b").addEventListener("click", function(){ chip.remove(); if (!box.children.length) box.innerHTML='<span class="sc-empty">还没有引用——可打开 100 例清单挑几个</span>'; });
    box.appendChild(chip);
    flashToast("已引用「"+v+"」到候选词（生成关键词时一并参考）。");
  }
  function openDrawer(){ buildDrawer(); drawer.classList.add("show"); drawerMask.classList.add("show"); drawer.setAttribute("aria-hidden","false"); }
  function closeDrawer(){ drawer.classList.remove("show"); drawerMask.classList.remove("show"); drawer.setAttribute("aria-hidden","true"); }
  document.getElementById("drawerClose").addEventListener("click", closeDrawer);
  drawerMask.addEventListener("click", closeDrawer);
  drawerSearch.addEventListener("input", function(){
    var q = this.value.trim();
    drawerGrid.querySelectorAll(".example-chip").forEach(function(c){
      c.style.display = (!q || c.textContent.indexOf(q) >= 0) ? "" : "none";
    });
  });

  /* ----------------- 导航 / 顶部按钮 ----------------- */
  stripBtns.forEach(function(b){
    b.addEventListener("click", function(){
      var n = parseInt(b.getAttribute("data-target"),10);
      if (n > lastReached) return;
      renderStep(n);
    });
  });
  document.querySelectorAll(".step-nav .item").forEach(function(it){
    it.addEventListener("click", function(){
      switchTab("steps");
      var s = parseInt(it.getAttribute("data-step"),10);
      if (s <= lastReached) renderStep(s);
    });
  });
  document.getElementById("prevChapBtn").addEventListener("click", function(){ flashToast("（原型）上一章入口占位：ch03 三圆。"); });
  document.getElementById("nextChapBtn").addEventListener("click", function(){ flashToast("（原型）下一章入口占位：ch05 擅长。"); });

  /* ----------------- 常量（step-1 题面 / 引导问题，来自 config input_schema / guiding_questions） ----------------- */
  var STEP1_Q = [
    "你尊敬的人、朋友、喜欢的角色分别是谁？你尊敬或喜欢他们哪些地方？",
    "小时候和青春期影响你最大的经历是什么？对你的价值观造成了什么影响？",
    "现在社会有什么不足？你有什么想解决的社会问题？",
    "问周围的人「你觉得我在人生中看重什么」，会得到怎样的答案？",
    "你最想给别人（孩子/后辈/朋友）什么建议？最不想告诉他们什么？"
  ];
  var STEP1_GUIDE = [
    "你尊敬的人身上，闪着哪些你也想要活出来的特质？",
    "你做哪件事会忘记时间、且越做越觉得自己「活着」？",
    "如果现在不够有动力，是目标偏离了你的价值观吗？"
  ];

  function esc(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }

  /* ----------------- 启动 ----------------- */
  renderStep(1);
})();
</script>
</body>
</html>
